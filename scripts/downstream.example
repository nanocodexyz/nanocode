nanocode-ts https://github.com/nanocodexyz/nanocode-ts run ln -sfn "$NANOCODE_WORKTREE" ../nanocodex && cargo check --target wasm32-unknown-unknown --lib && npm ci --ignore-scripts --no-audit --no-fund && npm run build:ts
swarms https://github.com/gakonst/swarms run pnpm install --frozen-lockfile && rm -rf node_modules/nanocode-ts && ln -s "$NANOCODE_DOWNSTREAM_DIR/nanocode-ts" node_modules/nanocode-ts && node_modules/.bin/tsc -b --force --pretty false && node_modules/.bin/tsc -p cli --noEmit --pretty false
